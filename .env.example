# ---- Identity -----------------------------------------------------------
COMPANY_NAME="G-SUS & Demonkoncernen AB"     # shown in the dashboard, page titles and supplier inquiries
PLATFORM_NAME=Rocky

# ---- Core -------------------------------------------------------------
APP_ENV=development                 # "production" refuses to start with the default SECRET_KEY
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./rocky.db   # docker-compose overrides this with PostgreSQL
POSTGRES_PASSWORD=rocky
CORS_ORIGINS=http://localhost:3000  # only needed if a browser calls the API from ANOTHER origin; the app uses one origin
BACKEND_URL=http://127.0.0.1:8000   # where the web server proxies /api (build time); docker-compose uses http://api:8000
DK_SITE=localhost                   # host name for the https profile (docker compose --profile https up)
# API_RATE_PER_MIN=600              # per client IP; behind the web server's own proxy all clients share one IP
TOKEN_TTL_HOURS=12

# ---- Public demo (separate deployment only — never on the private Control Center) ------------------
# DEMO_MODE=1                       # anonymous visitor sessions, sample data, forced offline, setup disabled
# DEMO_SESSION_TTL_MIN=120          # visitor session length
# DEMO_ACTIONS_PER_SESSION=30       # G-sus runs / Ask / evals per visitor session
# DEMO_SESSIONS_PER_CLIENT_HOUR=10  # per client address (best effort behind proxies)
# DEMO_SESSIONS_PER_HOUR=300        # hard global cap
# DEMO_RESET_HOURS=6                # full reset + reseed of the demo database
# AUDIT_MIN_RETENTION_DAYS=365      # audit records younger than this can never be pruned
# GIT_SHA=                          # build commit shown by /api/version (set by the image build)

# ---- AI (Anthropic) -----------------------------------------------------
ANTHROPIC_API_KEY=                  # without it, LLM-backed agents report their tasks as "blocked"
LLM_ENABLED=true
MODEL_DEEP=claude-opus-5-5
MODEL_STANDARD=claude-sonnet-5-5
MODEL_FAST=claude-haiku-5-5

# ---- Governance --------------------------------------------------------
DAILY_COST_LIMIT_USD=20
MAX_TASK_DEPTH=3
TASK_TIMEOUT_S=120
TASK_MAX_ATTEMPTS=3
DEDUPE_WINDOW_HOURS=24

# ---- Autonomous operating loop ----------------------------------------
SCHEDULER_ENABLED=false
SCHEDULER_TICK_S=300

# ---- Research connectors (official APIs) -------------------------------
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=rocky-commerce-intel/0.1 (by u/your_account)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_DE
ETSY_API_KEY=

# ---- Commerce ----------------------------------------------------------
SHOPIFY_STORE_DOMAIN=               # your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=

# Planned adapters (not implemented yet) and their variables: see INTEGRATIONS.md.
